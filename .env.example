# Modo de dados da camada BFF (app/api/**): "mock" ou "real"
# mock -> os Route Handlers respondem com fixtures internas
# real -> os Route Handlers repassam a chamada para o back-end (Nest.js/Python)
API_MODE=mock

# URLs dos back-ends externos (usadas apenas quando API_MODE=real,
# e apenas dentro dos Route Handlers — nunca expostas ao client)
NEST_API_URL=http://localhost:3001
PYTHON_API_URL=http://localhost:8000

# Timeout padrão (ms) para chamadas feitas pela camada BFF ao back-end real
API_TIMEOUT_MS=5000

# Segredo usado para assinar o token mock emitido por POST /api/auth/login
# (API_MODE=mock). Sem valor real de segurança — é trocado pelo JWT do
# Nest.js quando API_MODE=real.
AUTH_MOCK_SECRET=start-crm-mock-secret-change-me
